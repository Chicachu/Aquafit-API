# Development only: .env is loaded when NODE_ENV !== 'production'.
# In production (e.g. Koyeb), set these in the platform's Environment variables, not in a file.

# Server port (8000 on Koyeb)
PORT=8000

# Required in all environments
JWT_SECRET=your-secret-here
MONGO_URI=mongodb+srv://...

# Production CORS: origin(s) of the UI. Multiple allowed, comma-separated (no spaces or with spaces).
# FRONTEND_URL=https://aquafitvallarta.com,https://www.aquafitvallarta.com
FRONTEND_URL=https://yourdomain.com

# --- Production (Koyeb etc.): same format, one per line ---
# Set in dashboard or bulk edit; do not commit a real .env.production.
# PORT=8000
# FRONTEND_URL=https://yourdomain.com
# JWT_SECRET={{ secret.YOUR_JWT_SECRET }}
# MONGO_URI={{ secret.MONGO_URI }}
